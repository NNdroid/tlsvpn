managed_paths() {
  printf '%s\n' \
    "$INSTALL_DIR/$PROGRAM" "$CONFIG_DIR" "$STATE_FILE" "$INSTALLER_COPY" \
    "$SYSCTL_FILE" "$SYSTEMD_SERVICE" "$SYSTEMD_MAINT_SERVICE" "$SYSTEMD_MAINT_TIMER" \
    "$OPENRC_SERVICE" "$ALPINE_DAILY"
}

create_backup() {
  run mkdir -p "$BACKUP_DIR"
  CURRENT_BACKUP="${BACKUP_ID:-$(date +%Y%m%d-%H%M%S)}"
  local dir="$BACKUP_DIR/$CURRENT_BACKUP" p
  run mkdir -p "$dir"
  local list=()
  while IFS= read -r p; do [[ -e "$p" || -L "$p" ]] && list+=("$p"); done < <( managed_paths )
  if [[ ${#list[@]} -gt 0 ]]; then
    run tar -czf "$dir/files.tar.gz" "${list[@]}"
  else
    run tar -czf "$dir/files.tar.gz" --files-from /dev/null
  fi
  info "Backup created: $CURRENT_BACKUP"
 }

latest_backup() {
  [[ -d "$BACKUP_DIR" ]] || return 1
  find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort | tail -n1
}

restore_backup() {
  local id="${BACKUP_ID:-$(latest_backup || true)}"
  [[ -n "$id" && -f "$BACKUP_DIR/$id/files.tar.gz" ]] || die "No backup found."
  stop_service || true
  local p
  while IFS= read -r p; do
    run rm -rf "$p"
  done < <(managed_paths)
  run tar -xzf "$BACKUP_DIR/$id/files.tar.gz" -C /
  reload_init
  start_service || true
  info "Rolled back to backup: $id"
}

resolve_arch() {
  [[ "$ARCH" == "auto" ]] && ARCH="$HOST_ARCH"
  case "$ARCH" in
    amd64) RELEASE_ASSET="tlsvpn_linux_amd64" ;;
    arm64) RELEASE_ASSET="tlsvpn_linux_arm64" ;;
    arm64-v8.2|arm64v8.2|a55) ARCH="arm64-v8.2"; RELEASE_ASSET="tlsvpn_linux_arm64_v8.2" ;;
    armv7|arm) ARCH="armv7"; RELEASE_ASSET="tlsvpn_linux_arm" ;;
    *) die "Unsupported --arch: $ARCH" ;;
  esac
}

latest_release_tag() {
  curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" |
    sed -n 's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1
}

resolve_release() {
  resolve_arch
  if [[ "$VERSION" == "latest" ]]; then
    RELEASE_TAG="$(latest_release_tag)"
    [[ -n "$RELEASE_TAG" ]] || die "Could not resolve latest GitHub release."
  else
    RELEASE_TAG="$VERSION"
  fi
}

download_tlsvpn() {
  resolve_release
  local tmp url
  tmp="$(mktemp)"
  url="https://github.com/$REPO/releases/download/$RELEASE_TAG/$RELEASE_ASSET"
  info "Downloading $RELEASE_ASSET from $RELEASE_TAG"
  curl -fL --retry 3 --connect-timeout 15 -o "$tmp" "$url"
  chmod +x "$tmp"
  [[ -s "$tmp" ]] ||  { rm -f "$tmp"; die "Downloaded binary is empty."; }
  run mkdir -p "$INSTALL_DIR"
  run install -m 755 "$tmp" "$INSTALL_DIR/$PROGRAM"
  rm -f "$tmp"
}

lego_arch() {
  case "$HOST_ARCH" in
    amd64) printf '%s' "amd64" ;;
    arm64) printf '%s' "arm64" ;;
    armv7) printf '%s' "armv7" ;;
  esac
}

install_lego() {
  have lego && return 0
  local tag asset tmp dir
  tag="$(curl -fsSL https://api.github.com/repos/go-acme/lego/releases/latest |
    sed -n 's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
  [[ -n "$tag" ]] || die "Could not resolve latest lego release."
  asset="lego_${tag}_linux_$(lego_arch).tar.gz"
  tmp="$(mktemp)"; dir="$(mktemp -d)"
  curl -fL --retry 3 -o "$tmp" "https://github.com/go-acme/lego/releases/download/$tag/$asset"
  tar -xzf "$tmp" -C "$dir" lego
  run install -m 755 "$dir/lego" /usr/local/bin/lego
  rm -rf "$tmp" "$dir"
}

maybe_migrate_lego() {
  [[ -d "$LEGO_HOME" ]] || return 0
  [[ -d "$LEGO_HOME/accounts" || -d "$LEGO_HOME/certificates" ]] || return 0
  if [[ -d "$LEGO_HOME/accounts/acme-v02.api.letsencrypt.org" ]]; then
    info "Migrating lego v4 state to v5 format"
    run /usr/local/bin/lego migrate --path "$LEGO_HOME"
  fi
}

lego_run() {
  [[ -n "$CERT_NAME" && -n "$EMAIL" ]] || die "lego requires --cert-name and --email."
  install_lego
  run mkdir -p "$LEGO_HOME"
  maybe_migrate_lego
  local args=(run --accept-tos --email "$EMAIL" --server "$ACME_SERVER" --path "$LEGO_HOME" --domains "$CERT_NAME")
  if is_ip_identifier "$CERT_NAME"; then
    args+=(--profile shortlived)
  fi
  case "$ACME_CHALLENGE" in
    http) args+=(--http --http.address ":80") ;;
    tls) args+=(--tls --tls.address ":443") ;;
  esac
  run /usr/local/bin/lego "${args[@]}"
  CERT_FI