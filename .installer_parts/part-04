LE="$LEGO_HOME/certificates/$CERT_NAME.crt"
  KEY_FILE="$LEGO_HOME/certificates/$CERT_NAME.key"
  [[ "$DRY_RUN" == "yes" || ( -s "$CERT_FILE" && -s "$KEY_FILE" ) ]] ||
    die "lego completed but certificate files were not found."
}

prepare_self_signed() {
  [[ -n "$CERT_NAME" ]] || CERT_NAME="$(hostname -f 2>/dev/null || hostname)"
  run mkdir -p "$CERT_DIR"
  CERT_FILE="$CERT_DIR/server.crt"
  KEY_FILE="$CERT_DIR/server.key"
  local san
  if is_ip_identifier "$CERT_NAME"; then san="IP:$CERT_NAME"; else san="DNS:$CERT_NAME"; fi
  if [[ "$DRY_RUN" == "yes" ]]; then
    run openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -keyout "$KEY_FILE" -out "$CERT_FILE" -subj "/CN=$CERT_NAME" -addext "subjectAltName=$san"
  else
    openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
      -keyout "$KEY_FILE" -out "$CERT_FILE" -subj "/CN=$CERT_NAME" \
      -addext "subjectAltName=$san" >/dev/null 2>&1
    chmod 600 "$KEY_FILE"
  fi
}

prepare_existing_certificate() {
  [[ -s "$CERT_FILE" && -s "$KEY_FILE" ]] || die "--cert-file and --key-file must point to existing non-empty files."
  run mkdir -p "$CERT_DIR"
  run install -m 644 "$CERT_FILE" "$CERT_DIR/server.crt"
  run install -m 600 "$KEY_FILE" "$CERT_DIR/server.key"
  CERT_FILE="$CERT_DIR/server.crt"
  KEY_FILE="$CERT_DIR/server.key"
}

prepare_certificate() {
  case "$CERT_MODE" in
    lego) lego_run ;;
    self-signed) prepare_self_signed ;;
    existing) prepare_existing_certificate ;;
    none|"") CERT_FILE=""; KEY_FILE="" ;;
    *) die "--cert-mode must be lego, self-signed, existing or none" ;;
  esac
}

