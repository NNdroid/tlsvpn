l disable --now tlsvpn >/dev/null 2>&1 || true ;;
    openrc) rc-service tlsvpn stop >/dev/null 2>&1 || true; rc-update del tlsvpn default >/dev/null 2>&1 || true ;;
  esac
}

write_maintenance_task() {
  if [[ "$DAILY_UPDATE" != "yes" ]]; then
    run rm -f "$SYSTEMD_MAINT_SERVICE" "$SYSTEMD_MAINT_TIMER" "$ALPINE_DAILY"
    [[ "$INIT_SYSTEM" == "systemd" ]] && run systemctl daemon-reload
    return 0
  fi
  run mkdir -p "$(dirname "$INSTALLER_COPY")"
  run install -m 755 "$0" "$INSTALLER_COPY"
  if [[ "$INIT_SYSTEM" == "systemd" ]]; then
    cat >"$SYSTEMD_MAINT_SERVICE" <<EOF
[Unit]
Description=TLSVPN daily maintenance

[Service]
Type=oneshot
ExecStart=$INSTALLER_COPY maintenance --non-interactive -y
EOF
    cat >"$SYSTEMD_MAINT_TIMER" <<EOF
[Unit]
Description=TLSVPN daily maintenance timer

[Timer]
OnCalendar=*-*-* 03:35:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF
    run systemctl daemon-reload
    run systemctl enable --now tlsvpn-maintenance.timer
  else
    cat >"$ALPINE_DAILY" <<EOF
#!/bin/sh
exec $INSTALLER_COPY maintenance --non-interactive -y
EOF
    chmod 755 "$ALPINE_DAILY"
  fi
}

install_kernel_tuning() {
  [[ "$KERNEL_TUNING" == "yes" ]] || return 0
  cat >"$SYSCTL_FILE" <<'EOF'
# Managed by tlsvpn scripts/install.sh
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
net.core.default_qdisc = fq
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 16384
net.core.rmem_max = 33554432
net.core.wmem_max = 33554432
net.ipv4.tcp_rmem = 4096 131072 33554432
net.ipv4.tcp_wmem = 4096 131072 33554432
EOF
  if sysctl net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -qw bbr; then
    printf '%s\n' 'net.ipv4.tcp_congestion_control = bbr' >>"$SYSCTL_FILE"
  fi
  if ! run sysctl -p "$SYSCTL_FILE"; then warn "Some kernel tuning parameters could not be applied."; fi
}

install_xanmod() {
  [[ "$XANMOD" == "yes" ]] || return 0
  if [[ "$PKG_MGR" != "apt" || "$HOST_ARCH" != "amd64" ]]; then
    warn "XanMod is supported by this installer only on Debian/Ubuntu amd64; skipping."
    return 0
  fi
  install_packages ca-certificates wget gnupg lsb-release
  run mkdir -p /etc/apt/keyrings
  if [[ "$DRY_RUN" == "yes" ]]; then
    info "Would install XanMod repository key and $XANMOD_PACKAGE."
    return 0
  fi
  wget -qO - https://dl.xanmod.org/archive.key | gpg --dearmor -o "$XANMOD_KEY"
  printf 'deb [signed-by=%s] http://deb.xanmod.org %s main\n' "$XANMOD_KEY" "$(lsb_release -sc)" >"$XANMOD_LIST"
  apt-get update -y
  if ! env DEBIAN_FRONTEND=noninteractive apt-get install -y "$XANMOD_PACKAGE"; then
    warn "XanMod package installation failed; TLSVPN core installation will continue."
    return 0
  fi
  warn "XanMod installed. Reboot into the new kernel when convenient."
}

kernel_version_ge_510() {
  local v
  v="$(uname -r | sed 's/[^0-9.].*//')"
  local major="${v%%.*}" rest="${v#*.}" minor="${rest%%.*}"
  (( major > 5 || (major == 5 && minor >= 10) ))
}

install_tcp_brutal() {
  [[ "$TCP_BRUTAL" == "yes" ]] || return 0
  if [[ "$PKG_MGR" == "apk" ]]; then
    warn "TCP Brutal DKMS is not installed automatically on Alpine; skipping."
    return 0
  fi
  kernel_version_ge_510 || { warn "TCP Brutal requires Linux 5.10+; skipping."; return 0; }
  if [[ "$(uname -r)" == *xanmod* && "$FORCE_TCP_BRUTAL" != "yes" ]]; then
    warn "Running XanMod detected. DKMS compatibility can lag new XanMod kernels; use --force-tcp-brutal to attempt anyway."
    return 0
  fi
  case "$PKG_MGR" in
    apt) install_packages dkms "linux-headers-$(uname -r)" ;;
    dnf) install_packages dkms kernel-devel kernel-headers || true ;;
  esac
  if [[ "$DRY_RUN" == "yes" ]]; then
    info "Would run the upstream TCP Brutal installer."
    return 0
  fi
  if ! curl -fsSL https://tcp.hy2.sh/ | bash; then
    warn "TCP Brutal installation failed; TLSVPN core installation will continue."
  fi
}

remove_tcp_brutal() {
  have dkms || return 0
  local entries version
  entries="$(dkms status 2>/dev/null | grep -E '^tcp-brutal/' || true)"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    version="${line#tcp-brutal/}"; version="${version%%,*}"
    run dkms remove "tcp-brutal/$version" --all || true
  done <<<"$entries"
  run rm -f /usr/local/bin/brutalctl
}

install_action() {
  require_root; detect_platform; validate_common; install_base_dependencies
  [[ -n "$MODE" ]] || die "--mode is required in non-interactive installs."
  case "$CERT_MODE" in "") CERT_MODE="self-signed" ;; esac
  create_backup
  download_tlsvpn
  prepare_certificate
  write_config
  write_service
  install_kernel_tuning
  install_xanmod
  install_tcp_brutal
  INSTALLED_VERSION="$RELEASE_TAG"
  write_state
  write_maintenance_task
  start_service
  info "TLSVPN installed: $INSTALL_DIR/$PROGRAH