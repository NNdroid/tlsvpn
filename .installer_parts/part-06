  info "Config: $CONFIG_FILE"
  [[ -n "$WEB_AUTH" ]] && info "Dashboard auth: $WEB_AUTH"
}

upgrade_action() {
  require_root; detect_platform; install_base_dependencies; load_state
  create_backup
  local old="${INSTALLED_VERSION:-unknown}"
  download_tlsvpn
  INSTALLED_VERSION="$RELEASE_TAG"
  write_state
  restart_service
  info "TLSVPN upgraded from '$old' to $RELEASE_TAG."
}

maintenance_action() {
  require_root; detect_platform; install_base_dependencies; load_state
  local cert_checked="no"
  if [[ "$CERT_MODE" == "lego" && -n "$CERT_NAME" ]]; then
    info "Checking ACME certificate renewal."
    lego_run
    cert_checked="yes"
  fi
  local latest
  latest="$(latest_release_tag)"
  if [[ -n "$latest" && "$latest" != "${INSTALLED_VERSION:-}" ]]; then
    VERSION="$latest"
    create_backup
    download_tlsvpn
    INSTALLED_VERSION="$RELEASE_TAG"
    write_state
    restart_service
    info "Updated TLSVPN to $latest."
  else
    [[ "$cert_checked" == "yes" ]] && restart_service
    info "TLSVPN is already current (${latest:-unknown})."
  fi
}

uninstall_action() {
  require_root; detect_platform; load_state
  confirm "Remove TLSVPN?" || [[ "$ASSUME_YES" == "yes" ]] || die "Cancelled."
  create_backup
  stop_service
  run rm -f "$INSTALL_DIR/$PROGRAM" "$SYSTEMD_SERVICE" "$SYSTEMD_MAINT_SERVICE" "$SYSTEMD_MAINT_TIMER" "$OPENRC_SERVICE" "$ALPINE_DAILY" "$SYSCTL_FILE" "$INSTALLER_COPY"
  if [[ "$REMOVE_OPTIONAL" == "yes" ]]; then remove_tcp_brutal; fi
  if [[ "$PURGE" == "yes" ]]; then
    run rm -rf "$CONFIG_DIR" "$STATE_DIR"
    reload_init
    info "TLSVPN uninstalled and installer state purged."
    return 0
  fi
  reload_init
  info "TLSVPN uninstalled. Rollback snappshot: $CURRENT_BACKUP"
}

status_action() {
  detect_platform; load_state
  printf 'TLSVPN installer status\n'
  printf '  Binary: %s\n' "$INSTALL_DIR/$PROGRAM"
  if [[ -x "$INSTALL_DIR/$PROGRAM" ]]; then
    printf '  Version: %s\n' "${INSTALLED_VERSION:-unknown}"
  else
    printf '  Version: not installed\n'
  fi
  printf '  Config: %s %s\n' "$CONFIG_FILE" "$([[ -f "$CONFIG_FILE" ]] && echo present || echo missing)"
  printf '  Init: %s\n' "$INIT_SYSTEM"
  if [[ "$INIT_SYSTEM" == "systemd" ]]; then
    printf '  Service: %s\n' "$(systemctl is-active tlsvpn 2>/dev/null || true)"
    printf '  Daily timer: %s\n' "$(systemctl is-active tlsvpn-maintenance.timer 2>/dev/null || true)"
  else
    printf '  Service: %s\n' "$(rc-service tlsvpn status 2>/dev/null || true)"
  fi
  printf '  Kernel: %s\n' "$(uname -r)"
  printf '  TCP Brutal: %s\n' "$(have brutalctl && echo installed || echo not-installed)"
  printf '  XanMod running: %s\n' "$([[ "$(uname -r)" == *xanmod* ]] && echo yes || echo no)"
  if [[ -n "$CERT_FILE" && -f "$CERT_FILE" ]]; then
    printf '  Certificate: %s\n' "$CERT_FILE"
    openssl x509 -in "$CERT_FILE" -nout -subject -enddate 2>/dev/null | sed 's/^/    /' || true
  fi
}

main() {
  parse_args "$@"
  [[ -n "$ACTION" ]] || interactive_wizard
  [[ "$ACTION" == "help" ]] && { usage; return 0; }
  case "$ACTION" in
    install) install_action ;;
    upgrade) upgrade_action ;;
    uninstall) uninstall_action ;;
    rollback) require_root; detect_platform; load_state; restore_backup ;;
    maintenance) maintenance_action ;;
    status) status_action ;;
    *) die "Unknown action: $ACTION" ;;
  esac
}

main "$@"
