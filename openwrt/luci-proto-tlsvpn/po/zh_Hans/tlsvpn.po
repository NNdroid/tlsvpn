msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: zh_Hans\n"

msgid "TLSVPN server"
msgstr "TLSVPN 服务器"
msgid "One or more host:port endpoints separated by commas. Every endpoint is pinned to the pre-tunnel routing domain to prevent recursive routing."
msgstr "一个或多个以逗号分隔的 主机:端口 端点。每个端点都会固定到隧道建立前的路由域，以防止递归路由。"
msgid "Pre-shared key"
msgstr "预共享密钥"
msgid "Tunnel device"
msgstr "隧道设备"
msgid "Optional TAP device name. Linux interface names are limited to 15 characters."
msgstr "可选的 TAP 设备名称。Linux 接口名称最长为 15 个字符。"
msgid "Underlying network"
msgstr "底层网络"
msgid "Optional network used to reach the TLS transport endpoints. Leave empty to use normal routing."
msgstr "用于访问 TLS 传输端点的可选底层网络。留空则使用普通路由。"
msgid "Camouflage SNI"
msgstr "伪装 SNI"
msgid "Server certificate SHA-256"
msgstr "服务器证书 SHA-256"
msgid "Skip TLS certificate verification"
msgstr "跳过 TLS 证书验证"
msgid "Requested tunnel IPv4"
msgstr "请求的隧道 IPv4"
msgid "Requested tunnel IPv6"
msgstr "请求的隧道 IPv6"
msgid "TAP MAC address"
msgstr "TAP MAC 地址"
msgid "Parallel connections"
msgstr "并行连接数"
msgid "XOR FEC"
msgstr "XOR FEC"
msgid "FEC group size"
msgstr "FEC 分组大小"
msgid "Inner AES-GCM encryption"
msgstr "内层 AES-GCM 加密"
msgid "Inner cipher"
msgstr "内层加密算法"
msgid "AES-256-GCM (default)"
msgstr "AES-256-GCM（默认）"
msgid "AES-128-GCM (faster)"
msgstr "AES-128-GCM（更快）"
msgid "Minimum inner encryption"
msgstr "最低内层加密要求"
msgid "Require GCM"
msgstr "要求 GCM"
msgid "Allow TLS-only fallback"
msgstr "允许回退到仅 TLS"
msgid "Padding mode"
msgstr "填充模式"
msgid "Bucket"
msgstr "分桶"
msgid "Off"
msgstr "关闭"
msgid "Brutal upload rate (Mbps)"
msgstr "Brutal 上行速率 (Mbps)"
msgid "Brutal download rate (Mbps)"
msgstr "Brutal 下行速率 (Mbps)"
msgid "SOCKS5 proxy"
msgstr "SOCKS5 代理"
msgid "Log level"
msgstr "日志级别"
